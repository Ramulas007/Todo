				const cardId = createId('card')
				const ts = now()
				const card: Card = {
					id: cardId,
					title,
					description: '',
					tasks: [],
					position: 0,
					color: '#6366f1',
					priority: (priority as any) ?? 'medium',
					createdAt: ts,
					updatedAt: ts,
					history: [{ type: 'created', timestamp: ts, userId: effectiveUserId }],
