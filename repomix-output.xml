							>
								Cancel
							</button>
							<button
								type="button"
								onClick={handleClearAll}
								className="px-4 py-2 rounded-xl bg-red-500/20 border border-red-500/30 text-xs font-medium text-red-400 hover:bg-red-500/30 transition-all"
							>
								Delete All
							</button>
						</div>
					</div>
				</div>
			)}
		</div>
	);
}
